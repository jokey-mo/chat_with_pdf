# LLM (via OpenRouter, OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=anthropic/claude-3.7-sonnet
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-large
OPENROUTER_APP_NAME=chat_with_pdf
OPENROUTER_APP_URL=http://localhost:8501

# Optional: route embeddings to OpenAI direct (or any OpenAI-compatible endpoint)
# instead of OpenRouter. Useful if OpenRouter doesn't host your embed model.
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-...

# Paper sources
OPENALEX_API_KEY=
OPENALEX_EMAIL=you@example.com
UNPAYWALL_EMAIL=you@example.com
CORE_API_KEY=

# Infra
POSTGRES_DSN=postgresql+psycopg://rag:rag@postgres:5432/rag
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=paper_chunks
REDIS_URL=redis://redis:6379/0

# Storage
DATA_DIR=/data

# Embedding dimension (text-embedding-3-large = 3072)
EMBED_DIM=3072

# Retrieval
RETRIEVE_K=40
RERANK_TOP=8
ENABLE_RERANKER=false

# API + Frontend
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://api:8000
